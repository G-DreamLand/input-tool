<Window x:Class="InputTool.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Tool 提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True">

    <!--
        倒计时 / 进度 / 「下一行」预览浮层。见《软件开发设计文档》§6.3。
        硬约束：
        · 无边框、半透明、置顶；
        · 代码里在 SourceInitialized 时加 WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW，绝不抢焦点；
        · 面板配色固定为深色半透明（它是浮在别人窗口上的遮罩，不随应用主题变化）；
        · 「下一行」面板必须**限宽限高**：超宽折行、超高内部滚动，绝不让浮层长满屏幕。
    -->

    <Border Background="#E6121316" CornerRadius="10" Padding="22,16"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel MinWidth="212">

            <!-- 倒计时模式 -->
            <StackPanel x:Name="CountdownPanel">
                <TextBlock x:Name="CountdownNumber" Text="3" FontSize="42" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="CountdownCaption" Text="秒后开始输入…" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock x:Name="CountdownHint" Text="按 Esc 取消" Foreground="#8CFFFFFF" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <Button x:Name="CancelButton" Content="取消" Width="86" Height="28" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnCancelClick" />
            </StackPanel>

            <!-- 输入进度模式 -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressCaption" Text="输入中…" Foreground="White" FontWeight="SemiBold" />
                <ProgressBar x:Name="ProgressElement" Height="8" Margin="0,10,0,0"
                             Minimum="0" Maximum="100" />
                <TextBlock x:Name="ProgressDetail" Text="0 / 0 (0.0%)" Foreground="#CCFFFFFF"
                           FontSize="12" Margin="0,8,0,0" />
                <Button Content="停止" Width="86" Height="28" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnCancelClick" />
            </StackPanel>

            <!--
                逐行步进：显示「下一行」的源文本（FR 新增）。
                限宽：MaxWidth 让长行折行，而不是把浮层撑成一条横向长带；
                限高：滚动区 MaxHeight，超长行内部滚动查看，既不静默截断也不占满屏幕。
            -->
            <StackPanel x:Name="StepLinePanel" Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="StepLineCaption" Text="下一行"
                           Foreground="#8CFFFFFF" FontSize="12" />
                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <!-- 等宽字体便于看清缩进；中文回退到微软雅黑 -->
                        <TextBlock x:Name="StepLineText" Text="（空行）"
                                   Foreground="White" FontSize="14"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="StepLineHint" Text="继续下一行" Foreground="#8CFFFFFF" FontSize="12"
                           Margin="0,10,0,0" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
