<Window x:Class="InputTool.App.Views.FullTextViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="完整内容 — Input Tool"
        Width="780" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="完整内容" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock x:Name="SummaryText" Margin="0,6,0,10" TextWrapping="Wrap"
                       Style="{StaticResource HintTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSmall}">
            <!-- 列表开启虚拟化：几万行也只创建可见的那些元素，不会拖慢界面 -->
            <ListBox x:Name="LineList"
                     Background="Transparent" BorderThickness="0" Padding="6,4"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Left"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LineNumberText}" Width="48" TextAlignment="Right"
                                       Margin="0,0,10,0" Opacity="0.65"
                                       Style="{StaticResource PreviewMarkerStyle}" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource PreviewTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="复制全文" Width="96" Click="OnCopyAll"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="关闭" Width="84" Margin="10,0,0,0" IsCancel="True" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
