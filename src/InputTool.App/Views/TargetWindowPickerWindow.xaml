<Window x:Class="InputTool.App.Views.TargetWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择目标窗口 — Input Tool"
        Width="580" Height="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择目标窗口" Style="{StaticResource SectionHeaderTextStyle}" />

        <TextBlock Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}"
                   Text="列表按 Z 序排列（越靠上表示越近用过）。选定后，每次开始输入都会先把该窗口切到前台并回读校验；切换失败会明确提示，绝不会把字打到别的窗口。" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="TerminalsOnlyCheckBox" Content="只显示终端类窗口" IsChecked="True"
                          VerticalAlignment="Center"
                          Style="{StaticResource AppCheckBoxStyle}"
                          Click="OnFilterChanged" />
                <TextBlock x:Name="CountText" Margin="14,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource HintTextStyle}" />
                <Button Content="刷新" Width="64" Margin="14,0,0,0" Click="OnRefresh"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>

            <ListBox x:Name="TargetList" Grid.Row="1"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ClassName}" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="84" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="确定" Width="84" Margin="10,0,0,0" IsDefault="True" Click="OnConfirm"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
