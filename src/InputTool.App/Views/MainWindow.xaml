<Window x:Class="InputTool.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InputTool.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{x:Static vm:DesignData.Main}"
        Title="Input Tool — 键盘文本自动输入"
        Width="860" Height="780" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        主窗口。分区与《软件开发设计文档》§6.1 的线框图一致：
        ① 文本文件  ② 输入速度  ③ 行为设置  ④ 热键  ⑤ 控制  + 顶部错误条 + 状态栏
        交互规范见 §6.2；控件可用性由状态机驱动，见 §4.3 与 MainViewModel.IsDocumentEditable。
        布局约定：①②③④ 放在 ScrollViewer 中（可滚动），⑤ 控制区与状态栏固定在底部，
        保证核心操作按钮在任何窗口高度下都可见。
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ 顶部错误条（§10.1 Recoverable 级错误的呈现）══════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,10" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ErrorAdvice}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="以管理员身份重启" Height="26" Padding="10,0" Margin="0,0,8,0"
                            Command="{Binding RestartElevatedCommand}"
                            ToolTip="目标窗口以管理员身份运行时需要同权限（FR-027）" />
                    <Button Content="关闭" Height="26" Padding="10,0" Command="{Binding DismissErrorCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 主内容区 ══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ── ① 文本文件（FR-001 / FR-002 / FR-003 / FR-005）── -->
                <GroupBox Header="① 文本文件">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsDocumentEditable}"
                                     ToolTip="选择 .txt 文本文件，或直接粘贴完整路径（FR-001）" />
                            <Button Grid.Column="1" Content="浏览…" Width="76" Margin="8,0,0,0"
                                    Command="{Binding BrowseFileCommand}" />
                            <Button Grid.Column="2" Content="重载" Width="64" Margin="8,0,0,0"
                                    Command="{Binding ReloadFileCommand}" />
                            <Button Grid.Column="3" Content="所在文件夹" Width="92" Margin="8,0,0,0"
                                    Command="{Binding OpenContainingFolderCommand}"
                                    ToolTip="在资源管理器中定位该文件（FR-002.1）" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="编码" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="118" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding EncodingModes}"
                                      SelectedIndex="{Binding SelectedEncodingIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}"
                                      ToolTip="自动判定失败时可手动指定（FR-003.6）" />
                            <TextBlock Text="{Binding EncodingName}" Margin="12,0,0,0" FontWeight="SemiBold"
                                       Style="{StaticResource ValueTextStyle}" />
                            <TextBlock Text="{Binding StatisticsText}" Margin="24,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Button Content="查看完整内容…" Margin="24,0,0,0" Padding="10,2"
                                    Command="{Binding ShowFullTextCommand}"
                                    IsEnabled="{Binding IsDocumentEditable}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="预览只显示前 500 字符 / 40 行；这里可以查看并核对全文（FR-005.1）" />

                        </StackPanel>

                        <!-- 预览区：前 500 字符，换行显示 ↵、Tab 显示 →（FR-005.1/.3） -->
                        <Border Margin="0,10,0,0" MinHeight="120" MaxHeight="160"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}">

                            <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto" Padding="10,8">
                                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LineNumberText}" Width="32"
                                                                   TextAlignment="Right" Margin="0,0,10,0" Opacity="0.65"
                                                                   Style="{StaticResource PreviewMarkerStyle}" />
                                                        <TextBlock Text="{Binding Text}"
                                                                   Style="{StaticResource PreviewTextStyle}" />
                                                        <TextBlock x:Name="NewlineMarker" Text="↵" Margin="2,0,0,0"
                                                                   Style="{StaticResource PreviewMarkerStyle}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasTrailingNewline}" Value="False">
                                                            <Setter TargetName="NewlineMarker" Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                <TextBlock Text="（尚未加载文件）" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- ── ② 输入速度（FR-006 / FR-023）——会话中仍可调整，下一拍生效 ── -->
                <GroupBox Header="② 输入速度" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="每字符间隔" Width="80" Style="{StaticResource FieldLabelStyle}" />
                            <Slider Width="260" Minimum="1" Maximum="5000" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding IntervalMs, Mode=TwoWay}"
                                    ToolTip="10–5000 ms，默认 200 ms；输入过程中调整下一拍即生效（FR-006）" />
                            <TextBox Width="66" Margin="12,0,0,0" Text="{Binding IntervalMs, Mode=TwoWay}" />
                            <TextBlock Text="ms" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding CharactersPerSecondText}" Margin="18,0,0,0"
                                       Style="{StaticResource ValueTextStyle}" />
                            <TextBlock Text="单位" Margin="24,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="118" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding SpeedUnits}"
                                      SelectedIndex="{Binding SelectedSpeedUnitIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="快捷预设" Width="80" Style="{StaticResource FieldLabelStyle}" />
                            <Button Content="20 ms" Width="62" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="20" Margin="0,0,6,0" />
                            <Button Content="50 ms" Width="62" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="50" Margin="0,0,6,0" />
                            <Button Content="100 ms" Width="66" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="100" Margin="0,0,6,0" />
                            <Button Content="200 ms" Width="66" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="200" Margin="0,0,6,0" />
                            <Button Content="500 ms" Width="66" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="500" Margin="0,0,6,0" />
                            <Button Content="1000 ms" Width="72" Style="{StaticResource PresetButtonStyle}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="1000" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="抖动" Width="80" Style="{StaticResource FieldLabelStyle}" />
                            <Slider Width="200" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding JitterPercent, Mode=TwoWay}"
                                    ToolTip="0%–50%，0 表示完全一致（FR-006）" />
                            <TextBlock Text="{Binding JitterPercentText}" Width="46" Margin="12,0,0,0"
                                       Style="{StaticResource ValueTextStyle}" />
                            <TextBlock Text="行间隔额外延时" Margin="18,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="66" Margin="8,0,0,0" Text="{Binding LineExtraDelayMs, Mode=TwoWay}"
                                     ToolTip="每次回车后额外等待，终端场景建议 300–800 ms（FR-009）" />
                            <TextBlock Text="ms" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="换行前延时" Margin="18,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="66" Margin="8,0,0,0" Text="{Binding PreEnterDelayMs, Mode=TwoWay}" />
                            <TextBlock Text="ms" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="开始倒计时" Width="80" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="56" Text="{Binding CountdownSeconds, Mode=TwoWay}" />
                            <TextBlock Text="秒" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="0 表示立即开始（FR-012.6）" Margin="12,0,0,0"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Margin="80,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   Visibility="{Binding ShowFastModeHint, Converter={StaticResource BoolToVis}}"
                                   Text="极快模式（&lt; 20 ms）可能被目标程序丢弃按键，仍可使用（SRS §5.2.5）。" />
                    </StackPanel>
                </GroupBox>

                <!-- ── ③ 行为设置（FR-004 / FR-009 / FR-012 / FR-019 / FR-020）── -->
                <GroupBox Header="③ 行为设置" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="换行策略" Width="80" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Width="156" Margin="0,0,20,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding NewlineStrategies}"
                                      SelectedIndex="{Binding NewlineStrategyIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}"
                                      ToolTip="决定换行单元发什么按键（FR-009）" />
                            <CheckBox Content="末尾补回车" VerticalAlignment="Center"
                                      IsChecked="{Binding AppendTrailingEnter, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}"
                                      ToolTip="仅当文本末尾本来没有换行符时才补一个回车（Q-01）" />
                            <CheckBox Content="解析转义序列" Margin="18,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding ParseEscapes, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}"
                                      ToolTip="默认关闭：代码与正则里的 \n 应按字面量输入（FR-004.3）" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="忽略空行" VerticalAlignment="Center"
                                      IsChecked="{Binding IgnoreEmptyLines, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}" />
                            <CheckBox Content="跳过以 # 开头的行" Margin="18,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding SkipCommentLines, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}" />
                            <CheckBox Content="目标窗口焦点守护" Margin="18,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding FocusGuard, Mode=TwoWay}"
                                      IsEnabled="{Binding IsDocumentEditable}"
                                      ToolTip="失去焦点时按右侧动作处理，默认关闭（FR-020 / Q-04）" />
                            <ComboBox Width="132" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding FocusGuardActions}"
                                      SelectedIndex="{Binding FocusGuardActionIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding FocusGuard}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="完成提示音" VerticalAlignment="Center"
                                      IsChecked="{Binding PlayFinishSound, Mode=TwoWay}" />
                            <CheckBox Content="关闭时最小化到托盘" Margin="18,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- 终端场景安全提示（FR-009.3） -->
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintTextStyle}"
                                   Text="提示：在 CMD / PowerShell / 终端中，回车会立即执行该行命令，请确认命令安全后再开始；必要时改用「不发送回车」策略。" />
                    </StackPanel>
                </GroupBox>

                <!-- ── ④ 热键（FR-013 / FR-014 / FR-025 / FR-028）── -->
                <GroupBox Header="④ 热键" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="开始 / 暂停" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Width="96" Margin="8,0,28,0" IsReadOnly="True"
                                         Text="{Binding StartPauseHotkey}" />
                                <TextBlock Text="紧急停止" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Width="96" Margin="8,0,0,0" IsReadOnly="True"
                                         Text="{Binding EmergencyStopHotkey}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="恢复默认热键" Width="108"
                                    Command="{Binding ResetHotkeysCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="速度加快" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="140" Margin="8,0,28,0" IsReadOnly="True"
                                     Text="{Binding SpeedUpHotkey}" />
                            <TextBlock Text="速度减慢" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="140" Margin="8,0,0,0" IsReadOnly="True"
                                     Text="{Binding SpeedDownHotkey}" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintTextStyle}"
                                   Text="热键全局有效，输入过程中同样响应；紧急停止热键注册失败时将不允许开始输入（FR-014.5）。" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════ ⑤ 控制（FR-015 / FR-016 / FR-017）══════════ -->
        <GroupBox Grid.Row="2" Header="⑤ 控制" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding StartButtonText}" Width="120"
                            Height="{StaticResource ControlHeightLarge}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCommand}"
                            ToolTip="开始输入：先倒计时，再把焦点切到目标输入框（FR-012）" />
                    <Button Grid.Column="1" Content="{Binding PauseButtonText}" Width="100" Margin="10,0,0,0"
                            Height="{StaticResource ControlHeightLarge}"
                            Command="{Binding PauseResumeCommand}" />
                    <Button Grid.Column="2" Content="■ 停止 (F10)" Width="120" Margin="10,0,0,0"
                            Height="{StaticResource ControlHeightLarge}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"
                            ToolTip="紧急停止：200 ms 内彻底停止且不残留按键（FR-014）" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="目标窗口：" VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="128" SelectedIndex="{Binding SelectedTargetModeIndex, Mode=TwoWay}"
                                  ItemsSource="{Binding TargetWindowModes}"
                                  ToolTip="跟随前台窗口：用倒计时结束时的前台窗口｜自动：取最靠前的终端窗口｜固定：用「选择…」挑中的窗口" />
                        <Button Content="选择…" Width="66" Margin="6,0,0,0"
                                Command="{Binding ChooseTargetWindowCommand}"
                                ToolTip="从窗口列表里挑一个固定目标（FR-012.4）" />
                        <TextBlock Margin="8,0,0,0" MaxWidth="200" VerticalAlignment="Center"
                                   Text="{Binding TargetWindowText, Mode=OneWay}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   ToolTip="{Binding TargetWindowText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Margin="0,14,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}"
                               Style="{StaticResource ValueTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding TimingText}"
                               Style="{StaticResource FieldLabelStyle}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ══════════ 状态栏 ══════════ -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,8,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="状态：" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                               Style="{StaticResource ValueTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="18,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="{Binding DocumentInfoText, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="设置…" Height="24" Padding="10,0" Margin="0,0,8,0"
                            Style="{StaticResource PresetButtonStyle}" Command="{Binding OpenSettingsCommand}"
                            ToolTip="热键、日志、键盘模式等设置（FR-018 / FR-025）" />
                    <Button Content="打开日志目录" Height="24" Padding="8,0" Margin="0,0,8,0"
                            Style="{StaticResource PresetButtonStyle}" Command="{Binding OpenLogsCommand}" />
                    <Button Content="关于" Height="24" Padding="10,0" Margin="0,0,8,0"
                            Style="{StaticResource PresetButtonStyle}" Command="{Binding AboutCommand}" />
                    <Border Padding="8,2" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="管理员模式" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
