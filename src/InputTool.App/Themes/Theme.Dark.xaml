<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题 —— 键名与 Theme.Light.xaml 完全一致，仅取值不同。
        新增主题时必须保证键集合相同，否则控件样式会出现缺失画刷。
        依据《软件开发设计文档》§6.6。
    -->

    <Color x:Key="AppBackgroundColor">#1B1D21</Color>
    <Color x:Key="SurfaceColor">#24262B</Color>
    <Color x:Key="SurfaceAltColor">#1F2125</Color>
    <Color x:Key="BorderColor">#34373D</Color>
    <Color x:Key="BorderStrongColor">#454951</Color>

    <Color x:Key="TextPrimaryColor">#E6E8EB</Color>
    <Color x:Key="TextSecondaryColor">#9BA3AD</Color>
    <Color x:Key="TextDisabledColor">#6B7280</Color>

    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#6BA0FF</Color>
    <Color x:Key="AccentPressedColor">#3A78E0</Color>
    <Color x:Key="OnAccentColor">#0D1117</Color>
    <Color x:Key="SelectionColor">#1F3A5F</Color>

    <Color x:Key="DangerColor">#F2555A</Color>
    <Color x:Key="DangerHoverColor">#FF7076</Color>
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="WarningBackgroundColor">#33290C</Color>
    <Color x:Key="WarningBorderColor">#6B5A22</Color>
    <Color x:Key="WarningTextColor">#E8C36A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />

</ResourceDictionary>
