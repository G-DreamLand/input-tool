<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题 —— 只定义颜色与画刷。
        切换主题时由 ThemeManager 整体替换本字典（MergedDictionaries[0]），
        因此控件样式里对这些画刷必须使用 DynamicResource。
        依据《软件开发设计文档》§6.6。
    -->

    <!-- 基础色 -->
    <Color x:Key="AppBackgroundColor">#F3F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F7F8FA</Color>
    <Color x:Key="BorderColor">#E3E6EA</Color>
    <Color x:Key="BorderStrongColor">#C9CFD6</Color>

    <!-- 文字 -->
    <Color x:Key="TextPrimaryColor">#1F2328</Color>
    <Color x:Key="TextSecondaryColor">#656D76</Color>
    <Color x:Key="TextDisabledColor">#A0A6AD</Color>

    <!-- 强调 -->
    <Color x:Key="AccentColor">#2F6FEB</Color>
    <Color x:Key="AccentHoverColor">#2760D0</Color>
    <Color x:Key="AccentPressedColor">#1F51B3</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="SelectionColor">#E7F0FF</Color>

    <!-- 语义色 -->
    <Color x:Key="DangerColor">#D1242F</Color>
    <Color x:Key="DangerHoverColor">#B31D26</Color>
    <Color x:Key="SuccessColor">#1A7F37</Color>
    <Color x:Key="WarningBackgroundColor">#FFF7E0</Color>
    <Color x:Key="WarningBorderColor">#E8C36A</Color>
    <Color x:Key="WarningTextColor">#7A5200</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />

</ResourceDictionary>
